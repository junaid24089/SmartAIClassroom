  <!-- ==================== MODALS ==================== -->
  <!-- 1. Enroll Student Modal -->
  <div class="modal-backdrop" id="modal-add-student">
    <div class="modal-box">
      <div class="modal-header">
        <h3 style="font-size:14px; font-weight:700;">Enroll New Student</h3>
        <button onclick="closeModal('modal-add-student')" style="background:none; border:none; font-size:16px; cursor:pointer;">&times;</button>
      </div>
      <form id="form-add-student" onsubmit="handleCreateStudent(event)">
        <div class="modal-body">
          <div class="form-group">
            <label>Full Name</label>
            <input type="text" id="new-student-name" required placeholder="e.g. Maryam Ali" />
          </div>
          <div class="form-group">
            <label>Email Address</label>
            <input type="email" id="new-student-email" required placeholder="e.g. maryam.ali@bbsul.edu.pk" />
          </div>
          <div class="form-group">
            <label>Department</label>
            <select id="new-student-dept">
              <option value="Computer Science">Computer Science</option>
              <option value="Software Engineering">Software Engineering</option>
              <option value="Information Technology">Information Technology</option>
            </select>
          </div>
          <div class="form-group">
            <label>Semester (1-8)</label>
            <input type="number" id="new-student-semester" min="1" max="8" value="4" required />
          </div>
          <div class="form-group">
            <label>Section</label>
            <input type="text" id="new-student-section" value="A" required />
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn-action secondary" onclick="closeModal('modal-add-student')">Cancel</button>
          <button type="submit" class="btn-action primary">Save & Register Face Profile</button>
        </div>
      </form>
    </div>
  </div>

