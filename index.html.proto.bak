        showToast(`Random Seed Success: +${result.students.length} students, +${result.teachers.length} faculty, +${result.courses.length} courses, +${result.attendance.length} logs!`);
        refreshCurrentViewData();
        loadDashboardData();
      } catch (err) {
        showToast('Failed to generate random batch');
        console.error(err);
      }
    }

