  <!-- ==================== FRONTEND JAVASCRIPT ==================== -->
  <script>
    // App State
    let currentView = 'dashboard';
    let currentPersona = 'admin'; // 'admin' | 'faculty' | 'student'
    let webCamActive = false;

    // View Navigation
    function navigate(viewName) {
      currentView = viewName;
      document.querySelectorAll('.view-pane').forEach(el => el.classList.remove('active'));
      const targetPane = document.getElementById('view-' + viewName);
      if (targetPane) targetPane.classList.add('active');

      document.querySelectorAll('.nav-btn').forEach(btn => {
        btn.classList.toggle('active', btn.getAttribute('data-view') === viewName);
      });

      // Update Header Title
      const titleMap = {
        'dashboard': 'Dashboard',
        'live': 'Live Classroom',
        'attendance': 'Attendance Register',
        'syllabus': 'Syllabus Tracker',
        'students': 'Students Directory',
        'teachers': 'Teachers Directory',
        'courses': 'Courses & Subjects',
        'lectures': 'Lecture Logs',
        'reports': 'Lecture Reports'
      };
      document.getElementById('header-title-text').innerText = titleMap[viewName] || 'Dashboard';
      window.scrollTo({ top: 0, behavior: 'smooth' });

      // Refresh data on view change
      if (viewName === 'dashboard') loadDashboardData();
      if (viewName === 'attendance') loadAttendanceRecords();
      if (viewName === 'syllabus') loadSyllabusTopics();
      if (viewName === 'students') loadStudentsDirectory();
      if (viewName === 'teachers') loadTeachersDirectory();
      if (viewName === 'courses') loadCoursesDirectory();
      if (viewName === 'lectures') loadLecturesDirectory();
      if (viewName === 'reports') loadReportsDirectory();
    }

    // Bind sidebar buttons
    document.querySelectorAll('.nav-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const view = btn.getAttribute('data-view');
        if (view) navigate(view);
      });
    });

    document.getElementById('brand-header-trigger').addEventListener('click', () => navigate('dashboard'));
    document.getElementById('quick-action-btn').addEventListener('click', () => {
      if (currentView === 'students') openAddStudentModal();
      else if (currentView === 'teachers') openAddTeacherModal();
      else if (currentView === 'syllabus') openAddTopicModal();
      else openAddStudentModal();
    });

    // Persona Switcher
    const personas = [
      { role: 'admin', name: 'Sara Khan', roleLabel: 'Department Admin / Registrar', monogram: 'SK' },
      { role: 'faculty', name: 'Dr. Ayesha Malik', roleLabel: 'Associate Professor & Course Lead', monogram: 'AM' },
      { role: 'student', name: 'Ahmed Raza', roleLabel: 'Student · Roll No: CS-24-018', monogram: 'AR' }
    ];

    document.getElementById('persona-toggle-btn').addEventListener('click', () => {
      const curIdx = personas.findIndex(p => p.role === currentPersona);
      const nextP = personas[(curIdx + 1) % personas.length];
      currentPersona = nextP.role;
      document.getElementById('sidebar-user-name').innerText = nextP.name;
      document.getElementById('sidebar-user-role').innerText = nextP.roleLabel;
      document.getElementById('sidebar-user-avatar').innerText = nextP.monogram;
      showToast(`Switched persona to ${nextP.name} (${nextP.role})`);
    });

    // Toast Notification System
    function showToast(message) {
      const toast = document.getElementById('toast-notification');
      toast.innerText = message;
      toast.style.display = 'block';
      setTimeout(() => {
        toast.style.display = 'none';
      }, 3000);
    }

    // Modal helpers
    function openModal(id) {
      document.getElementById(id).classList.add('open');
    }
    function closeModal(id) {
      document.getElementById(id).classList.remove('open');
    }
    function openAddStudentModal() { openModal('modal-add-student'); }
    function openAddTeacherModal() { openModal('modal-add-teacher'); }
    function openAddTopicModal() { openModal('modal-add-topic'); }
    function openAddCourseModal() { openModal('modal-add-course'); }
    function openAddLectureModal() { openModal('modal-add-lecture'); }
    function openQrModal() { openModal('modal-qr'); }

    // ==================== CSV EXPORT SYSTEM ====================
    async function exportTableToCSV(type) {
      try {
        let endpoint = `/api/${type}`;
        if (type === 'dashboard') endpoint = '/api/lectures';
        const res = await fetch(endpoint);
        const data = await res.json();
        
        if (!Array.isArray(data) || data.length === 0) {
          showToast('No records available to export.');
          return;
        }

        const headers = Object.keys(data[0]);
        const csvRows = [headers.join(',')];

        data.forEach(item => {
          const values = headers.map(header => {
            const val = item[header] === undefined || item[header] === null ? '' : String(item[header]);
            return `"${val.replace(/"/g, '""')}"`;
          });
          csvRows.push(values.join(','));
        });

        const csvString = csvRows.join('\n');
        const blob = new Blob([csvString], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `registrar_${type}_export_${new Date().toISOString().slice(0,10)}.csv`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
        showToast(`Exported ${data.length} ${type} records to CSV`);
      } catch (err) {
        showToast('Error generating CSV export');
        console.error(err);
      }
    }

