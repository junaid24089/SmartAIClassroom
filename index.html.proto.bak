    function refreshCurrentViewData() {
      if (currentView === 'dashboard') loadDashboardData();
      else if (currentView === 'attendance') loadAttendanceRecords();
      else if (currentView === 'syllabus') loadSyllabusTopics();
      else if (currentView === 'students') loadStudentsDirectory();
      else if (currentView === 'teachers') loadTeachersDirectory();
      else if (currentView === 'courses') loadCoursesDirectory();
      else if (currentView === 'lectures') loadLecturesDirectory();
      else if (currentView === 'reports') loadReportsDirectory();
    }

    // ==================== API INTEGRATIONS ====================

    // 1. Dashboard API Loader
    async function loadDashboardData() {
      try {
        const statsRes = await fetch('/api/stats');
        const stats = await statsRes.json();
        document.getElementById('kpi-total-students').innerText = stats.totalStudents || '248';
        document.getElementById('kpi-total-teachers').innerText = stats.totalTeachers || '18';
        document.getElementById('kpi-today-lectures').innerText = stats.todayLectures || '12';
        document.getElementById('kpi-avg-attendance').innerText = (stats.averageAttendance || 84) + '%';
        document.getElementById('dash-present-count').innerText = stats.attendancePresentCount || '208';
        document.getElementById('dash-late-count').innerText = stats.attendanceLateCount || '17';
        document.getElementById('dash-absent-count').innerText = stats.attendanceAbsentCount || '23';

        const lecturesRes = await fetch('/api/lectures');
        const lectures = await lecturesRes.json();
        const tbody = document.getElementById('dashboard-lectures-tbody');
        tbody.innerHTML = '';

        lectures.slice(0, 4).forEach(lec => {
          const tr = document.createElement('tr');
          const isLive = lec.status === 'Live';
          tr.innerHTML = `
            <td>
              <div style="font-weight:700;">${lec.courseCode} ${lec.courseName}</div>
              <div style="font-size:10px; color:var(--text-faint);">${lec.teacherName}</div>
            </td>
            <td class="font-mono">${lec.room || 'Lab B-204'}</td>
            <td class="font-mono">${lec.startTime}–${lec.endTime}</td>
            <td class="font-mono">${lec.attendanceRate}%</td>
            <td style="text-align:right;">
              <span class="status-badge ${isLive ? 'live' : ''}">${isLive ? '● Live' : lec.status}</span>
            </td>
          `;
          tr.onclick = () => navigate('live');
          tbody.appendChild(tr);
        });
      } catch (err) {
        console.error('Error fetching dashboard data:', err);
      }
    }

    // 2. Attendance Register API Loader
    async function loadAttendanceRecords() {
      try {
        const res = await fetch('/api/attendance');
        const records = await res.json();
        renderAttendanceTable(records);
      } catch (err) {
        console.error('Error loading attendance:', err);
      }
    }

    function filterAttendanceRecords() {
      const courseFilter = document.getElementById('att-filter-course').value;
      const searchFilter = document.getElementById('att-search-input').value.toLowerCase();

      fetch('/api/attendance')
        .then(res => res.json())
        .then(records => {
          let filtered = records;
          if (courseFilter !== 'All') {
            filtered = filtered.filter(r => r.courseCode === courseFilter);
          }
          if (searchFilter) {
            filtered = filtered.filter(r => 
              (r.studentName && r.studentName.toLowerCase().includes(searchFilter)) ||
              (r.rollNumber && r.rollNumber.toLowerCase().includes(searchFilter))
            );
          }
          renderAttendanceTable(filtered);
        });
    }

    function renderAttendanceTable(records) {
      const tbody = document.getElementById('attendance-tbody');
      tbody.innerHTML = '';
      document.getElementById('att-record-count').innerText = `${records.length} records`;

      records.forEach(rec => {
        const tr = document.createElement('tr');
        const statusClass = rec.status ? rec.status.toLowerCase() : 'present';
        tr.innerHTML = `
          <td><strong>${rec.studentName}</strong></td>
          <td class="font-mono">${rec.rollNumber}</td>
          <td class="font-mono">${rec.courseCode}</td>
          <td class="font-mono">${rec.timestamp}</td>
          <td style="font-size:10.5px; color:var(--text-faint);">${rec.method}</td>
          <td><span class="status-badge ${statusClass}">${rec.status}</span></td>
          <td style="text-align:right;">
            <button class="btn-action secondary" style="padding:2px 6px; font-size:10px; margin-right:4px;" onclick="toggleAttendanceStatus('${rec.id}', '${rec.status}')">Toggle Status</button>
            <button class="btn-action secondary" style="padding:2px 6px; font-size:10px;" onclick="deleteAttendanceRecord('${rec.id}')">Delete</button>
          </td>
        `;
        tbody.appendChild(tr);
      });
    }

    async function toggleAttendanceStatus(id, currentStatus) {
      const nextStatus = currentStatus === 'Present' ? 'Absent' : currentStatus === 'Absent' ? 'Late' : 'Present';
      try {
        await fetch(`/api/attendance/${id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status: nextStatus, timestamp: new Date().toLocaleTimeString('en-GB') })
        });
        showToast(`Updated attendance status to ${nextStatus}`);
        loadAttendanceRecords();
        loadDashboardData();
      } catch (err) {
        showToast('Failed to update status');
      }
    }

    async function deleteAttendanceRecord(id) {
      if (!confirm('Delete this attendance entry?')) return;
      try {
        await fetch(`/api/attendance/${id}`, { method: 'DELETE' });
        showToast('Attendance entry deleted');
        loadAttendanceRecords();
        loadDashboardData();
      } catch (err) {
        showToast('Error deleting attendance log');
      }
    }

    async function markAllPresentAction() {
      try {
        await fetch('/api/attendance/bulk-present', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({})
        });
        showToast('All registered students marked PRESENT for today');
        if (currentView === 'attendance') loadAttendanceRecords();
        if (currentView === 'dashboard') loadDashboardData();
      } catch (err) {
        showToast('Bulk update error');
      }
    }

    async function simulateStudentScan() {
      try {
        await fetch('/api/attendance/simulate-qr', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
