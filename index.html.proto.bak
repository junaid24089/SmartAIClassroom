            <rect x="70" y="10" width="20" height="20" />
            <rect x="10" y="70" width="20" height="20" />
            <rect x="38" y="10" width="8" height="8" />
            <rect x="52" y="10" width="8" height="8" />
            <rect x="38" y="38" width="24" height="24" />
            <rect x="70" y="50" width="10" height="10" />
            <rect x="50" y="70" width="10" height="10" />
            <rect x="70" y="70" width="20" height="20" />
          </svg>
        </div>
        <p style="font-family:var(--font-mono); font-size:11px; color:var(--text-main); font-weight:600;">TOKEN: BBSUL-LIVE-CS301-TOKEN-9418</p>
        <p style="font-size:11px; color:var(--text-faint); margin-top:0.25rem;">Students scan with university portal mobile app to register geolocation presence.</p>
      </div>
      <div class="modal-footer" style="justify-content:center;">
        <button class="btn-action primary" onclick="simulateStudentScan()">Simulate Student Scan</button>
      </div>
    </div>
  </div>

