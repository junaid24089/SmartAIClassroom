    // 3. Syllabus Tracker API Loader
    async function loadSyllabusTopics() {
      const courseId = document.getElementById('syllabus-filter-course').value;
      const heading = document.getElementById('syllabus-course-heading');
      if (heading) heading.innerText = `${courseId} Topic Breakdown`;

      try {
        const res = await fetch(`/api/syllabus?courseId=${courseId}`);
        const topics = await res.json();
        const tbody = document.getElementById('syllabus-tbody');
        tbody.innerHTML = '';

        let coveredCount = 0;
        topics.forEach((t, idx) => {
          const isCovered = t.status === 'Covered';
          if (isCovered) coveredCount++;
          const tr = document.createElement('tr');
          tr.innerHTML = `
            <td>
              <input type="checkbox" ${isCovered ? 'checked' : ''} onchange="toggleTopicCovered('${t.id}', this.checked)" style="cursor:pointer;" />
            </td>
            <td>
              <div style="font-weight:700;">Week ${idx + 1}: ${t.title}</div>
              <div style="font-size:10px; color:var(--text-faint);">${t.description || 'Core theoretical concepts and practical labs.'}</div>
            </td>
            <td class="font-mono">${t.estimatedHours} hrs</td>
            <td class="font-mono">${t.lectureCovered || (isCovered ? 'Lecture 12 (09:00)' : '—')}</td>
            <td style="text-align:right;">
              <button class="btn-action secondary" style="padding:2px 6px; font-size:10px; margin-right:4px;" onclick="toggleTopicCovered('${t.id}', ${!isCovered})">${isCovered ? 'Mark Pending' : 'Mark Covered'}</button>
              <button class="btn-action secondary" style="padding:2px 6px; font-size:10px;" onclick="deleteTopic('${t.id}')">Delete</button>
            </td>
          `;
          tbody.appendChild(tr);
        });

        const percent = topics.length > 0 ? Math.round((coveredCount / topics.length) * 100) : 76;
        document.getElementById('syllabus-percent-badge').innerText = `${percent}% COVERED (${coveredCount}/${topics.length})`;
      } catch (err) {
        console.error('Error loading syllabus topics:', err);
      }
    }

    async function toggleTopicCovered(topicId, isChecked) {
      const status = isChecked ? 'Covered' : 'Pending';
      try {
        await fetch(`/api/syllabus/${topicId}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status })
        });
        showToast(`Topic marked as ${status}`);
        loadSyllabusTopics();
      } catch (err) {
        showToast('Failed to update syllabus topic');
      }
    }

    async function deleteTopic(id) {
      if (!confirm('Remove this topic from curriculum?')) return;
      try {
        await fetch(`/api/syllabus/${id}`, { method: 'DELETE' });
        showToast('Syllabus topic removed');
        loadSyllabusTopics();
      } catch (err) {
        showToast('Error removing topic');
      }
    }

    // 4. Students Directory API Loader
    async function loadStudentsDirectory() {
      const search = document.getElementById('student-search-input').value;
      const dept = document.getElementById('student-dept-select').value;
      let url = '/api/students?';
      if (search) url += `search=${encodeURIComponent(search)}&`;
      if (dept && dept !== 'All') url += `department=${encodeURIComponent(dept)}&`;

      try {
        const res = await fetch(url);
        const students = await res.json();
        const tbody = document.getElementById('students-tbody');
        tbody.innerHTML = '';
        document.getElementById('students-count-badge').innerText = `${students.length} students enrolled`;

        students.forEach(st => {
          const tr = document.createElement('tr');
          tr.innerHTML = `
            <td>
              <div style="font-weight:700;">${st.name}</div>
              <div style="font-size:10px; color:var(--text-faint);">${st.email}</div>
            </td>
            <td class="font-mono">${st.rollNumber}</td>
            <td>${st.department}</td>
            <td class="font-mono">Semester ${st.semester} (${st.section || 'A'})</td>
            <td class="font-mono">${st.attendanceRate}%</td>
            <td class="font-mono font-bold">${st.gpa || '3.50'}</td>
            <td style="text-align:right;">
              <button class="btn-action secondary" style="padding:2px 6px; font-size:10px; margin-right:4px;" onclick="viewStudentDetails('${st.id}')">View Dossier</button>
              <button class="btn-action secondary" style="padding:2px 6px; font-size:10px;" onclick="deleteStudent('${st.id}')">Remove</button>
            </td>
          `;
          tbody.appendChild(tr);
        });
      } catch (err) {
        console.error('Error loading students:', err);
      }
    }

    async function viewStudentDetails(id) {
      try {
        const res = await fetch(`/api/students`);
        const list = await res.json();
        const st = list.find(s => s.id === id);
        if (!st) return;

        const container = document.getElementById('student-detail-content');
        container.innerHTML = `
          <div style="display:flex; align-items:center; gap:1rem; margin-bottom:1rem; padding:0.75rem; background:#f4f6f0; border-radius:4px;">
            <div style="width:48px; height:48px; border-radius:50%; background:var(--forest-green); color:var(--accent-cream); display:flex; align-items:center; justify-content:center; font-weight:700; font-size:18px;">
              ${st.name.split(' ').map(n=>n[0]).join('').slice(0,2)}
            </div>
            <div>
              <h4 style="margin:0; font-size:14px; font-weight:700;">${st.name}</h4>
              <p style="margin:2px 0 0; font-size:11px; color:var(--text-faint);">${st.rollNumber} · ${st.department}</p>
            </div>
          </div>
          <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.5rem; font-size:11px; margin-bottom:1rem;">
            <div><strong>Email:</strong> ${st.email}</div>
            <div><strong>Semester:</strong> Semester ${st.semester} (Sec ${st.section || 'A'})</div>
            <div><strong>Attendance Rate:</strong> <span style="color:var(--accent-green); font-weight:700;">${st.attendanceRate}%</span></div>
            <div><strong>GPA:</strong> ${st.gpa || '3.50'}</div>
            <div><strong>Biometric Face ID:</strong> <span style="color:var(--accent-green);">Registered & Verified</span></div>
            <div><strong>Status:</strong> Active Enrolled</div>
          </div>
          <div style="font-size:11px; border-top:1px solid var(--border-light); padding-top:0.75rem;">
            <strong>Recent Attendance Summary:</strong>
            <p style="color:var(--text-faint); margin-top:0.25rem;">Present in CS-301 (09:04 AM) · Present in SE-214 (Yesterday) · Present in CS-205 (2 days ago)</p>
          </div>
        `;

        document.getElementById('student-detail-action-btn').onclick = async () => {
          try {
            await fetch('/api/attendance', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                studentId: st.id,
                studentName: st.name,
                rollNumber: st.rollNumber,
                courseCode: 'CS-301',
                status: 'Present',
                method: 'Manual Registrar Stamp',
                timestamp: new Date().toLocaleTimeString('en-GB')
              })
            });
            showToast(`Logged instant presence for ${st.name}`);
            closeModal('modal-student-detail');
            loadAttendanceRecords();
            loadDashboardData();
          } catch(e) {
            showToast('Error stamping presence');
          }
        };

        openModal('modal-student-detail');
      } catch (err) {
        console.error(err);
      }
    }

    async function handleCreateStudent(e) {
      e.preventDefault();
      const name = document.getElementById('new-student-name').value;
      const email = document.getElementById('new-student-email').value;
      const department = document.getElementById('new-student-dept').value;
      const semester = Number(document.getElementById('new-student-semester').value);
      const section = document.getElementById('new-student-section').value;

      try {
        await fetch('/api/students', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, email, department, semester, section })
        });
        closeModal('modal-add-student');
        document.getElementById('form-add-student').reset();
        showToast(`Enrolled ${name} successfully into ${department}`);
        loadStudentsDirectory();
        loadDashboardData();
      } catch (err) {
        showToast('Error enrolling student');
      }
    }

    async function deleteStudent(id) {
      if (!confirm('Are you sure you want to remove this student record from the ledger?')) return;
      try {
        await fetch(`/api/students/${id}`, { method: 'DELETE' });
        showToast('Student record removed');
        loadStudentsDirectory();
        loadDashboardData();
      } catch (err) {
        showToast('Error deleting student');
      }
    }

