    async function viewTeacherDetails(id) {
      try {
        const res = await fetch(`/api/teachers`);
        const list = await res.json();
        const tc = list.find(t => t.id === id);
        if (!tc) return;

        const container = document.getElementById('teacher-detail-content');
        container.innerHTML = `
          <div style="display:flex; align-items:center; gap:1rem; margin-bottom:1rem; padding:0.75rem; background:#f4f6f0; border-radius:4px;">
            <div style="width:48px; height:48px; border-radius:50%; background:var(--accent-navy); color:#ffffff; display:flex; align-items:center; justify-content:center; font-weight:700; font-size:18px;">
              ${tc.name.split(' ').map(n=>n[0]).join('').slice(0,2)}
            </div>
            <div>
              <h4 style="margin:0; font-size:14px; font-weight:700;">${tc.name}</h4>
              <p style="margin:2px 0 0; font-size:11px; color:var(--text-faint);">${tc.title} · ${tc.department}</p>
            </div>
          </div>
          <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.5rem; font-size:11px; margin-bottom:1rem;">
            <div><strong>Email:</strong> ${tc.email}</div>
            <div><strong>Department:</strong> ${tc.department}</div>
            <div><strong>Lectures Logged:</strong> ${tc.totalLecturesLogged} sessions</div>
            <div><strong>Avg Class Attendance:</strong> <span style="color:var(--accent-green); font-weight:700;">${tc.averageAttendance}%</span></div>
            <div><strong>Office Hours:</strong> Mon-Thu 14:00–16:00</div>
            <div><strong>Research Group:</strong> Distributed AI & Systems</div>
          </div>
          <div style="font-size:11px; border-top:1px solid var(--border-light); padding-top:0.75rem;">
            <strong>Assigned Courses:</strong>
            <p style="color:var(--text-faint); margin-top:0.25rem;">CS-301 Object-Oriented Programming · CS-205 Database Management Systems</p>
          </div>
        `;
        openModal('modal-teacher-detail');
      } catch (err) {
        console.error(err);
      }
    }

    async function handleCreateTeacher(e) {
      e.preventDefault();
      const name = document.getElementById('new-teacher-name').value;
      const title = document.getElementById('new-teacher-title').value;
      const email = document.getElementById('new-teacher-email').value;
      const department = document.getElementById('new-teacher-dept').value;

      try {
        await fetch('/api/teachers', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, title, email, department })
        });
        closeModal('modal-add-teacher');
        document.getElementById('form-add-teacher').reset();
        showToast(`Registered faculty member ${name}`);
        loadTeachersDirectory();
        loadDashboardData();
      } catch (err) {
        showToast('Error registering faculty member');
      }
    }

    async function deleteTeacher(id) {
      if (!confirm('Are you sure you want to remove this faculty member from the directory?')) return;
      try {
        await fetch(`/api/teachers/${id}`, { method: 'DELETE' });
        showToast('Faculty member record removed');
        loadTeachersDirectory();
        loadDashboardData();
      } catch (err) {
        showToast('Error deleting teacher');
      }
    }

    async function handleCreateTopic(e) {
      e.preventDefault();
      const courseId = document.getElementById('new-topic-course').value;
      const title = document.getElementById('new-topic-title').value;
      const estimatedHours = Number(document.getElementById('new-topic-hours').value);
      const description = document.getElementById('new-topic-desc').value;

      try {
        await fetch('/api/syllabus', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ courseId, title, estimatedHours, description, status: 'Pending' })
        });
        closeModal('modal-add-topic');
        document.getElementById('form-add-topic').reset();
        showToast(`Added topic "${title}" to course ${courseId}`);
        loadSyllabusTopics();
      } catch (err) {
        showToast('Error adding syllabus topic');
      }
    }

    // 6. Courses Directory API Loader
    async function loadCoursesDirectory() {
      const search = document.getElementById('course-search-input').value;
      let url = '/api/courses?';
      if (search) url += `search=${encodeURIComponent(search)}&`;

      try {
        const res = await fetch(url);
        const courses = await res.json();
        const tbody = document.getElementById('courses-tbody');
        tbody.innerHTML = '';
        document.getElementById('courses-count-badge').innerText = `${courses.length} courses cataloged`;

        courses.forEach(c => {
          const tr = document.createElement('tr');
          tr.innerHTML = `
            <td class="font-mono font-bold">${c.code}</td>
            <td>${c.name}</td>
            <td>${c.teacherName}</td>
            <td class="font-mono">${c.creditHours} CR</td>
            <td class="font-mono">${c.studentsEnrolled}</td>
            <td class="font-mono">${c.syllabusCoverage}%</td>
            <td style="text-align:right;">
              <button class="btn-action secondary" style="padding:2px 6px; font-size:10px; margin-right:4px;" onclick="viewCourseDetails('${c.code}', '${c.name}')">View Syllabus</button>
              <button class="btn-action secondary" style="padding:2px 6px; font-size:10px;" onclick="deleteCourse('${c.id}')">Delete</button>
            </td>
          `;
          tbody.appendChild(tr);
        });
      } catch (err) {
        console.error('Error loading courses:', err);
      }
    }

    async function handleCreateCourse(e) {
      e.preventDefault();
      const code = document.getElementById('new-course-code').value;
      const name = document.getElementById('new-course-title').value;
      const teacherName = document.getElementById('new-course-teacher').value;
      const department = document.getElementById('new-course-dept').value;
      const creditHours = Number(document.getElementById('new-course-credits').value);

      try {
        await fetch('/api/courses', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ code, name, teacherName, department, creditHours })
        });
        closeModal('modal-add-course');
        document.getElementById('form-add-course').reset();
        showToast(`Created course ${code}: ${name}`);
        loadCoursesDirectory();
      } catch (err) {
        showToast('Error creating course');
      }
    }

    async function deleteCourse(id) {
      if (!confirm('Are you sure you want to delete this course from the catalog?')) return;
      try {
        await fetch(`/api/courses/${id}`, { method: 'DELETE' });
        showToast('Course deleted');
        loadCoursesDirectory();
        loadDashboardData();
      } catch (err) {
        showToast('Error deleting course');
      }
    }

    function viewCourseDetails(code, name) {
      navigate('syllabus');
      const select = document.getElementById('syllabus-filter-course');
      if (select) {
        let exists = false;
        for (let opt of select.options) {
          if (opt.value === code) exists = true;
        }
        if (!exists) {
          const opt = document.createElement('option');
          opt.value = code;
          opt.innerText = `${code} ${name}`;
          select.appendChild(opt);
        }
        select.value = code;
        loadSyllabusTopics();
      }
    }

    // 7. Lectures Logs API Loader
    async function loadLecturesDirectory() {
      const status = document.getElementById('lectures-filter-status').value;
      let url = '/api/lectures?';
      if (status && status !== 'All') url += `status=${encodeURIComponent(status)}&`;

      try {
        const res = await fetch(url);
        const lectures = await res.json();
        const tbody = document.getElementById('lectures-tbody');
        tbody.innerHTML = '';

        lectures.forEach(lec => {
          const tr = document.createElement('tr');
          const isLive = lec.status === 'Live';
          tr.innerHTML = `
            <td class="font-mono">${lec.id}</td>
            <td><strong>${lec.courseCode}</strong> - ${lec.courseName}</td>
            <td>${lec.teacherName}</td>
            <td class="font-mono">${lec.date} (${lec.startTime}–${lec.endTime})</td>
            <td class="font-mono">${lec.attendanceRate}%</td>
            <td><span class="status-badge ${isLive ? 'live' : ''}">${lec.status}</span></td>
            <td style="text-align:right;">
              <button class="btn-action secondary" style="padding:2px 6px; font-size:10px; margin-right:4px;" onclick="toggleLectureStatus('${lec.id}', '${lec.status}')">${isLive ? 'End Session' : 'Go Live'}</button>
              <button class="btn-action secondary" style="padding:2px 6px; font-size:10px;" onclick="deleteLecture('${lec.id}')">Delete</button>
            </td>
          `;
          tbody.appendChild(tr);
        });
      } catch (err) {
        console.error('Error loading lectures:', err);
      }
    }

    async function handleCreateLecture(e) {
      e.preventDefault();
      const courseCode = document.getElementById('new-lecture-course').value;
      const teacherName = document.getElementById('new-lecture-teacher').value;
      const room = document.getElementById('new-lecture-room').value;
      const startTime = document.getElementById('new-lecture-start').value;
      const endTime = document.getElementById('new-lecture-end').value;

      try {
        await fetch('/api/lectures', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            courseCode,
            courseName: courseCode === 'CS-301' ? 'Object-Oriented Programming' : courseCode === 'SE-214' ? 'Web Engineering' : 'Database Systems',
            teacherName,
            room,
            startTime,
            endTime,
            date: 'Today',
            status: 'Live',
            attendanceRate: 85
          })
        });
        closeModal('modal-add-lecture');
        document.getElementById('form-add-lecture').reset();
        showToast(`Lecture scheduled for ${courseCode} in ${room}`);
        loadLecturesDirectory();
        loadDashboardData();
      } catch (err) {
        showToast('Error scheduling lecture');
      }
    }

    async function toggleLectureStatus(id, currentStatus) {
      const nextStatus = currentStatus === 'Live' ? 'Completed' : 'Live';
      try {
        await fetch(`/api/lectures/${id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status: nextStatus })
        });
        showToast(`Lecture marked as ${nextStatus}`);
        loadLecturesDirectory();
        loadDashboardData();
      } catch (err) {
        showToast('Error updating lecture');
      }
    }

    async function deleteLecture(id) {
      if (!confirm('Are you sure you want to delete this lecture record?')) return;
      try {
        await fetch(`/api/lectures/${id}`, { method: 'DELETE' });
        showToast('Lecture record removed');
        loadLecturesDirectory();
        loadDashboardData();
      } catch (err) {
        showToast('Error deleting lecture');
      }
    }

    // 8. Reports API Loader
    async function loadReportsDirectory() {
      try {
        const res = await fetch('/api/reports');
        const reports = await res.json();
        const tbody = document.getElementById('reports-tbody');
        tbody.innerHTML = '';

        reports.forEach(rpt => {
          const tr = document.createElement('tr');
          tr.innerHTML = `
            <td class="font-mono font-bold">${rpt.id}</td>
            <td>${rpt.courseCode} · ${rpt.courseName}</td>
            <td class="font-mono">${rpt.generatedAt}</td>
            <td class="font-mono">${rpt.attendanceRate}%</td>
            <td class="font-mono">${rpt.syllabusCoverage}%</td>
            <td style="text-align:right;">
              <button class="btn-action secondary" style="padding:2px 6px; font-size:10px; margin-right:4px;" onclick="viewReportDetails('${rpt.id}')">View Summary</button>
              <button class="btn-action secondary" style="padding:2px 6px; font-size:10px;" onclick="deleteReport('${rpt.id}')">Delete</button>
            </td>
          `;
          tbody.appendChild(tr);
        });
      } catch (err) {
        console.error('Error loading reports:', err);
      }
    }

    async function viewReportDetails(id) {
      try {
        const res = await fetch(`/api/reports`);
        const list = await res.json();
        const rpt = list.find(r => r.id === id);
        if (!rpt) return;

        const container = document.getElementById('report-detail-content');
        container.innerHTML = `
          <div style="border-bottom:1px solid var(--border-light); padding-bottom:0.75rem; margin-bottom:0.75rem;">
            <div style="font-size:10px; color:var(--text-faint); font-family:var(--font-mono);">AUDIT REPORT ID: ${rpt.id}</div>
            <h4 style="margin:4px 0 0; font-size:14px; font-weight:700;">${rpt.courseCode} — ${rpt.courseName}</h4>
            <p style="margin:2px 0 0; font-size:11px; color:var(--text-faint);">Generated on ${rpt.generatedAt} by Registrar Automated Telemetry</p>
          </div>
          <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.5rem; font-size:11px; margin-bottom:1rem;">
            <div><strong>Overall Attendance Rate:</strong> <span style="color:var(--accent-green); font-weight:700;">${rpt.attendanceRate}%</span></div>
            <div><strong>Curriculum Syllabus Coverage:</strong> <span style="color:var(--accent-navy); font-weight:700;">${rpt.syllabusCoverage}%</span></div>
            <div><strong>Total Lectures Delivered:</strong> ${rpt.totalLecturesDelivered || 24}</div>
            <div><strong>Total Students Enrolled:</strong> ${rpt.studentsEnrolled || 29}</div>
          </div>
          <div style="background:#f4f6f0; padding:0.75rem; border-radius:4px; font-size:11px; margin-bottom:1rem;">
            <strong>Executive Registrar Assessment:</strong>
            <p style="margin:0.25rem 0 0; color:var(--text-main);">${rpt.summary || 'Course compliance satisfies BBSUL accreditation standards. AI facial telemetry confirms standard seat occupancy above 80% with minimal unexcused absences.'}</p>
          </div>
        `;
        openModal('modal-report-detail');
      } catch (err) {
        console.error(err);
      }
    }

    async function deleteReport(id) {
      if (!confirm('Are you sure you want to delete this compliance report?')) return;
      try {
        await fetch(`/api/reports/${id}`, { method: 'DELETE' });
        showToast('Report deleted');
        loadReportsDirectory();
      } catch (err) {
        showToast('Error deleting report');
      }
    }

    // Real Camera / Webcam Feed Toggle & AI Simulator
    document.getElementById('btn-camera-toggle').addEventListener('click', async () => {
      const video = document.getElementById('webcam-element');
      const placeholder = document.getElementById('camera-placeholder');
      
      if (!webCamActive) {
        try {
          if (navigator.mediaDevices && navigator.mediaDevices.getUserMedia) {
            const stream = await navigator.mediaDevices.getUserMedia({ video: true });
            video.srcObject = stream;
            video.style.display = 'block';
            placeholder.style.display = 'none';
            webCamActive = true;
            showToast('Live Camera Feed initialized with Real-Time AI Detection Overlay');
          } else {
            showToast('Webcam API not available in iframe mode; simulator active');
          }
        } catch (e) {
          showToast('Simulator mode active (Camera permission bypassed)');
        }
      } else {
        if (video.srcObject) {
          video.srcObject.getTracks().forEach(track => track.stop());
        }
        video.style.display = 'none';
        placeholder.style.display = 'block';
        webCamActive = false;
        showToast('Webcam turned off');
      }
    });

    function simulateFaceScanDetection() {
      const stream = document.getElementById('live-events-stream');
      const timeStr = new Date().toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
      const randomNames = ['Zainab Bibi', 'Farhan Akhtar', 'Hamza Tariq', 'Danish Ali', 'Fatima Zahra'];
      const pick = randomNames[Math.floor(Math.random() * randomNames.length)];
      const roll = 'CS-24-0' + Math.floor(10 + Math.random() * 80);

      const div = document.createElement('div');
      div.style.padding = '0.45rem 0.6rem';
      div.style.borderLeft = '3px solid var(--accent-green)';
      div.style.background = '#fbfcf9';
      div.style.fontSize = '11px';
      div.innerHTML = `<strong>${timeStr}</strong> — ${pick} (${roll}) auto-verified via Face ID (Confidence 99%)`;
      if (stream) stream.prepend(div);
      showToast(`AI Face Scanner matched: ${pick} (${roll})`);
    }

    // Keyboard Shortcuts (⌘K for Search)
    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        navigate('students');
        document.getElementById('student-search-input')?.focus();
      }
    });

    document.getElementById('global-search-btn').addEventListener('click', () => {
      navigate('students');
      document.getElementById('student-search-input')?.focus();
    });

    // Initialize application on load
    document.addEventListener('DOMContentLoaded', () => {
      loadDashboardData();
    });
  </script>
</body>
</html>
